# ============================================================================
#  Heavy artifacts — archived on Zenodo, NOT committed (see DATA.md).
#  These rules are the exact complement of what zenodo/make_archives.sh bundles.
# ============================================================================

# Trained model weights (state_dicts)
*.pth
# ...but keep the tiny loss-doc arrays that kept notebooks read, and reserve a slot
# for a small sample model to be whitelisted later (deferred bgLV example):
!*_traindoc.pth
# !simulations/VAE_gLV_simulation/vae_models/<sample>.pth   # add when example is integrated

# Simulation trajectory arrays (the small .mat / .pkl generation params in these
# folders are deliberately NOT matched here, so they stay tracked for provenance).
# NOTE: only saved_sims/ is ignored — the small reconstruction/FUV .txt caches in
# saved_data/ are kept in-repo so the Summary figures reproduce without a download.
**/saved_sims/**/*.npy
**/saved_sims/**/*.npz
**/saved_sims/**/*.txt
**/saved_sims/**/*.csv

# Reconstruction arrays
**/mlpvae_reconstruction/

# Large cross-validation datasets (>100 MB; the small *_embedding_FUV_CV caches stay)
experiments/lab_microbiome/lab_microbiome_datasets_CV/
experiments/vaginal_microbiome/vaginal_dataset_CV/

# Local Zenodo staging tarballs
zenodo/archives/

# Local-only archive of deprecated/superseded material (not part of the release)
archive/

# ============================================================================
#  Removed for the release (figures + abandoned loss curves) — keep them out
# ============================================================================
*.png
*.pdf
*.docx
figures/
*_traindoc.pkl

# ============================================================================
#  Caches / OS / scheduler cruft
# ============================================================================
__pycache__/
*.py[cod]
.DS_Store
.ipynb_checkpoints/
slurm-*.out
slurm_outputs/
.nb_backup_ridge

# Zenodo archive/upload job logs (transient; upload logs can contain tokens in URLs)
zenodo/upload_*.log
zenodo/make_archives.log

# Raw generator example data -> Zenodo (simulation_code_rawdata.tar.gz)
simulation_code/network sparsity/random_init.txt

# ============================================================================
#  bgLV in-repo training example (I1 / T2 / random, trial 1) — kept in git so
#  `train_bgLV_simulations.py 1 100 2 random 1` runs end-to-end without Zenodo.
#  (Negations come after all ignore rules above, so they win.)
# ============================================================================
!simulations/VAE_gLV_simulation/saved_sims/bgLV/I1/bgLV_B98_T2_random_train.npy
!simulations/VAE_gLV_simulation/saved_sims/bgLV/I1/bgLV_B98_T2_random_test.npy
!simulations/VAE_gLV_simulation/vae_models/bgLV/I1/random_B98_T2_E*_trial1.pth
